[Unit]
Description=Droid mount for /system (system/ directory of the system-as-root image)
Requires=mnt-sysroot.mount
After=mnt-sysroot.mount
Before=local-fs.target systemd-modules-load.service

[Mount]
What=/mnt/sysroot/system
Where=/system
Type=none
Options=bind,ro
TimeoutSec=10

[Install]
WantedBy=local-fs.target
